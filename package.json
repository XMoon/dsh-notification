{
  "name": "dsh-notification",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishit130/dsh-notification.git"
  },
  "version": "0.1.2-local.1",
  "description": "Lightweight DeepSeek Harness host desktop and webhook notifications with subagent-tree settlement and user-question alerts.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "npm run check && node --test test/index.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notification",
    "webhook"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3",
    "@deepseek-ai/dsh-scope": ">=0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
